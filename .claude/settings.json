{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "search_files",
      "Terminal(cd /home/tsugiri/Desktop/Nomad && mvn *)",
      "Terminal(cd /home/tsugiri/Desktop/Nomad && npm *)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": {
      "Edit": {
        "matchers": [
          { "type": "regex", "pattern": "\\.env" },
          { "type": "regex", "pattern": "application.*\\.properties" }
        ],
        "hooks": [
          {
            "type": "warn",
            "message": "You're editing a configuration file that may contain credentials. Ensure no hardcoded secrets are being added."
          }
        ]
      }
    },
    "PostToolUse": {
      "Edit": {
        "matchers": [
          { "type": "filePattern", "pattern": "**/*.java" }
        ],
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/tsugiri/Desktop/Nomad && mvn compile -q",
            "description": "Compile Java after edit"
          }
        ]
      }
    }
  }
}